# Copy this file to .env.local and fill in your Supabase credentials.
# For local development with `supabase start`, use the values below.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key from `supabase status`>

# Hosted Supabase: Dashboard → Authentication → URL Configuration → Redirect URLs must include
# your app origin AND .../login (e.g. https://yourapp.com/login) so signup / magic-link emails work.
